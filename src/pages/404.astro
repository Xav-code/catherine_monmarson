---
import Base from '../layouts/Base.astro';
import { useT, route } from '../i18n/ui';
const t = useT('fr');
---
<Base lang="fr" paths={{ fr: '/404', en: '/404' }} title={t('notfound.title')} noindex>
  <section class="hero" style="padding-block: var(--s10)">
    <h1 style="font-size: var(--t-2xl)">{t('notfound.title')}</h1>
    <p class="lede hero__sub">{t('notfound.note')}</p>
    <p style="margin-top: var(--s6)">
      <a class="btn" href={route('fr', 'works')}>{t('notfound.cta')}</a>
    </p>
  </section>
</Base>
