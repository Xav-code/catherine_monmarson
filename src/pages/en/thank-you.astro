---
import Base from '../../layouts/Base.astro';
import { useT, route } from '../../i18n/ui';
const t = useT('en');
---
<Base lang="en" paths={{ fr: '/merci', en: '/thank-you' }} title={t('thanks.title')} noindex>
  <section class="hero" style="padding-block: var(--s10) var(--s9)">
    <h1 style="font-size: var(--t-2xl)">{t('thanks.title')}</h1>
    <p class="lede hero__sub">{t('thanks.note')}</p>
    <p style="margin-top: var(--s6)">
      <a class="btn" href={route('en', 'works')}>{t('thanks.cta')}</a>
    </p>
  </section>
</Base>
